# CalmSekai Pipeline — environment variables
# Copy this file to .env and fill in your actual keys.
# .env is never committed to version control.

# --- API Keys ---
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
FAL_KEY=...

# --- YouTube OAuth2 ---
# Path to the client_secret.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_PATH=C:/Users/cnjro/Documents/calm_sekai/calmsekai_pipeline/client_secret.json

# --- Providers (swappable) ---
VIDEO_PROVIDER=grok       # options: grok | runway | kling
IMAGE_PROVIDER=dalle3     # options: dalle3 | falai

# --- Fal.ai anime LoRA (required only if IMAGE_PROVIDER=falai) ---
# Paste a public direct-download URL to a .safetensors LoRA file.
# Example sources: Civitai, Hugging Face model files
FAL_ANIME_MODEL=fal-ai/flux-lora
FAL_ANIME_LORA_URL=https://huggingface.co/your-username/your-anime-lora/resolve/main/model.safetensors

# --- FFmpeg ---
# Leave blank if ffmpeg is on your system PATH, otherwise set full path:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg

# --- Pipeline root (defaults to folder containing config.py) ---
# ROOT_DIR=C:/Users/cnjro/Documents/calm_sekai/calmsekai_pipeline

# --- Suno API (optional — AI music generation) ---
# Get your key at https://sunoapi.org
SUNO_API_KEY=your_suno_key_here
SUNO_BASE_URL=https://api.sunoapi.org

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
